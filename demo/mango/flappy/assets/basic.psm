.alias iPos v0
.alias iColor v1
.alias oPos o0
.alias oColor o1

.alias uProj0 f0
.alias uProj1 f1
.alias uProj2 f2
.alias uProj3 f3

.entry main vertex

.set main f95 (0.00392156862745, 0, 0, 0)
.out main o0 position
.out main o1 color

main:
    dp4 oPos.x, uProj0, iPos
    dp4 oPos.y, uProj1, iPos
    dp4 oPos.z, uProj2, iPos
    dp4 oPos.w, uProj3, iPos

    mul oColor, iColor, f95.xxxx
    end
